{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIAM",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageWorkloadRolePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh",
        "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/SiteWorkloadBoundary"
        }
      }
    },
    {
      "Sid": "AttachWorkloadPolicies",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh",
        "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/SiteWorkloadBoundary"
        },
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:aws:iam::ACCOUNT_ID:policy/site-workload/*",
            "arn:aws:iam::aws:policy/service-role/AmazonAPIGatewayPushToCloudWatchLogs"
          ]
        }
      }
    },
    {
      "Sid": "UpdateWorkloadRoles",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh",
        "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki"
      ]
    },
    {
      "Sid": "ManageWorkloadPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:policy/site-workload/*"
    },
    {
      "Sid": "NeverChangeOtherPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "NotResource": "arn:aws:iam::ACCOUNT_ID:policy/site-workload/*"
    },
    {
      "Sid": "NeverRemoveBoundaries",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "NeverChangeCIRoles",
      "Effect": "Deny",
      "NotAction": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/GithubDeployProduction",
        "arn:aws:iam::ACCOUNT_ID:role/GithubPlanProduction"
      ]
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyReadingSecrets",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "secretsmanager:GetSecretValue",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:StartLiveTail",
        "logs:GetLogRecord",
        "logs:Unmask"
      ],
      "Resource": "*"
    }
  ]
}

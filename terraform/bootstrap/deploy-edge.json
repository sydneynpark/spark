{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAPIs",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:us-east-1::/*"
    },
    {
      "Sid": "ManageCDNs",
      "Effect": "Allow",
      "Action": [
        "cloudfront:*",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCertificates",
      "Effect": "Allow",
      "Action": "acm:*",
      "Resource": "*"
    },
    {
      "Sid": "ManageDNS",
      "Effect": "Allow",
      "Action": "route53:*",
      "Resource": "*"
    }
  ]
}

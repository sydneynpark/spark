{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::spark-wiki-terraform-state"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::spark-wiki-terraform-state/terraform.tfstate*"
    },
    {
      "Sid": "ManageFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:Get*",
        "lambda:List*",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:ContentAPI",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:ContentAPI:*",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdatePhotoMetadata",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdatePhotoMetadata:*",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdateBlogPostMetadata",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdateBlogPostMetadata:*",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdateBookReview",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdateBookReview:*"
      ]
    },
    {
      "Sid": "PillowLayer",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:us-east-1:770693421928:layer:Klayers-p312-pillow:*"
    },
    {
      "Sid": "PassLambdaRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "PassAPIGatewayRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "apigateway.amazonaws.com" }
      }
    },
    {
      "Sid": "ReadIAM",
      "Effect": "Allow",
      "Action": ["iam:Get*", "iam:List*"],
      "Resource": "*"
    },
    {
      "Sid": "ManageWorkloadRolePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh",
        "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/SiteWorkloadBoundary"
        }
      }
    },
    {
      "Sid": "AttachAPIGatewayLogsPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/SiteWorkloadBoundary"
        },
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AmazonAPIGatewayPushToCloudWatchLogs"
        }
      }
    },
    {
      "Sid": "UpdateWorkloadRoles",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/ContentAPI-role-rab0br82",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/Lambda_UpdatePhotoMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/Lambda_UpdateBlogPostMetadata",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/UpdateBookReview-role-qcl2ltqh",
        "arn:aws:iam::ACCOUNT_ID:role/APIGateway_api.spark.wiki"
      ]
    },
    {
      "Sid": "NeverChangeBootstrapIAM",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverChangeCIRoles",
      "Effect": "Deny",
      "NotAction": ["iam:Get*", "iam:List*"],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/GithubDeployProduction",
        "arn:aws:iam::ACCOUNT_ID:role/GithubPlanProduction"
      ]
    },
    {
      "Sid": "FrontendList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::spark.wiki.frontend"
    },
    {
      "Sid": "FrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::spark.wiki.frontend/*"
    },
    {
      "Sid": "ManageBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketWebsite",
        "s3:DeleteBucketWebsite",
        "s3:PutBucketCORS",
        "s3:PutBucketNotification",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::spark.wiki.blog",
        "arn:aws:s3:::spark.wiki.books",
        "arn:aws:s3:::spark.wiki.frontend",
        "arn:aws:s3:::spark.wiki.photos",
        "arn:aws:s3:::spark.wiki.thumbnails"
      ]
    },
    {
      "Sid": "ManageTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Describe*",
        "dynamodb:ListTagsOfResource",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/spark.wiki.books",
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/spark.wiki.books/index/*",
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/spark.wiki.photos",
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/spark.wiki.photos/index/*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "ManageLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/ContentAPI*",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/UpdatePhotoMetadata*",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/UpdateBlogPostMetadata*",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/UpdateBookReview*",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:API-Gateway-Execution-Logs_f9e1sa8azj/LIVE*"
      ]
    },
    {
      "Sid": "ManageAPI",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:POST", "apigateway:PUT", "apigateway:PATCH", "apigateway:DELETE"],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/restapis/f9e1sa8azj/*",
        "arn:aws:apigateway:us-east-1::/domainnames/api.spark.wiki/*",
        "arn:aws:apigateway:us-east-1::/tags/*"
      ]
    },
    {
      "Sid": "UpdateAPI",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:PATCH"],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/restapis/f9e1sa8azj",
        "arn:aws:apigateway:us-east-1::/domainnames/api.spark.wiki",
        "arn:aws:apigateway:us-east-1::/account"
      ]
    },
    {
      "Sid": "ManageDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": [
        "arn:aws:cloudfront::ACCOUNT_ID:distribution/E2JO5BSJ5WRP9P",
        "arn:aws:cloudfront::ACCOUNT_ID:distribution/E2Y8FRIT378S9Y",
        "arn:aws:cloudfront::ACCOUNT_ID:distribution/E36I1WVQPNH4HH"
      ]
    },
    {
      "Sid": "ManageOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl"
      ],
      "Resource": [
        "arn:aws:cloudfront::ACCOUNT_ID:origin-access-control/E19M97ILNFAK9W",
        "arn:aws:cloudfront::ACCOUNT_ID:origin-access-control/E2TQ4ICD2J986O",
        "arn:aws:cloudfront::ACCOUNT_ID:origin-access-control/E7MZSHXZJOE22"
      ]
    },
    {
      "Sid": "ManageWebACLs",
      "Effect": "Allow",
      "Action": [
        "wafv2:GetWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:ListTagsForResource",
        "wafv2:TagResource",
        "wafv2:UntagResource"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:ACCOUNT_ID:global/webacl/CreatedByCloudFront-8dfd0590/a63601b9-8685-486d-a01c-80e14b7ff1ce",
        "arn:aws:wafv2:us-east-1:ACCOUNT_ID:global/webacl/CreatedByCloudFront-9decd9c5/373cc68c-fb1c-4fc2-a436-86d207b77e57",
        "arn:aws:wafv2:us-east-1:*:global/managedruleset/*/*"
      ]
    },
    {
      "Sid": "ManageCertificates",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate",
        "acm:AddTagsToCertificate",
        "acm:RemoveTagsFromCertificate",
        "acm:UpdateCertificateOptions"
      ],
      "Resource": [
        "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/373a1646-804c-45ce-9aef-ff9fe055e0f4",
        "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/b0cd0675-e400-4819-8fa5-312c62ee7edd"
      ]
    },
    {
      "Sid": "ManageDNS",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:ListTagsForResource",
        "route53:ChangeTagsForResource",
        "route53:UpdateHostedZoneComment"
      ],
      "Resource": "arn:aws:route53:::hostedzone/Z06879821CJYLNK8MINIR"
    },
    {
      "Sid": "DNSChanges",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "ContentRefresh",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdatePhotoMetadata",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:UpdateBookReview"
      ]
    },
    {
      "Sid": "ContentRefreshMissingOnly",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/spark.wiki.books"
    }
  ]
}
